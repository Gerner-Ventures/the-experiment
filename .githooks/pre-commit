#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"

echo "── pre-commit: frontend lint + typecheck ──"
cd "$ROOT/frontend"
npx eslint . --max-warnings=0
npx vue-tsc --noEmit

echo "── pre-commit: backend lint + format check ──"
cd "$ROOT/backend"
if [ -x .venv/bin/ruff ]; then
  .venv/bin/ruff check .
  .venv/bin/ruff format --check .
else
  echo "⚠ backend .venv not found — skipping backend checks (run 'make setup')"
fi

echo "✓ pre-commit passed"
