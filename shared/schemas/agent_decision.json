{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Decision",
  "description": "Structured output from an agent's LLM decision",
  "$defs": {
    "decisionActionType": {
      "type": "string",
      "enum": ["move", "gather", "repair", "trade", "talk", "hoard", "sabotage", "explore", "accuse", "vote", "rest", "observe", "attack", "threaten", "stab", "shoot", "poison", "dance", "pray", "rally", "mourn", "celebrate", "argue", "pee", "poop", "vomit", "sleep", "eat", "drink", "investigate", "monologue", "panic", "breakdown", "self_sacrifice"]
    },
    "consequenceActionType": {
      "type": "string",
      "description": "Engine-generated reactions. These must not be emitted by the LLM decision step.",
      "enum": ["bleeding", "injured", "stunned", "knocked_down", "burning", "poisoned", "crying", "fleeing"]
    },
    "actionTypeCatalog": {
      "anyOf": [
        { "$ref": "#/$defs/decisionActionType" },
        { "$ref": "#/$defs/consequenceActionType" }
      ]
    }
  },
  "type": "object",
  "properties": {
    "inner_thought": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "description": "A brief window into the agent's immediate reasoning. Keep it to 1-2 short sentences and avoid monologues."
    },
    "suspicion": { "type": ["string", "null"] },
    "action": {
      "type": "object",
      "properties": {
        "type": { "$ref": "#/$defs/decisionActionType" },
        "target": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["type"]
    },
    "dialogue": {
      "type": ["object", "null"],
      "properties": {
        "target": { "type": "string" },
        "message": { "type": "string" }
      },
      "required": ["target", "message"]
    },
    "goal_progress": { "type": "string" },
    "cooperation_intent": { "type": "string", "enum": ["high", "medium", "low", "none"] }
  },
  "required": ["inner_thought", "action", "goal_progress", "cooperation_intent"]
}
