# Database
DATABASE_URL=postgresql+asyncpg://experiment:experiment@localhost:5432/experiment

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (configure the ones you use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
GM_MODEL=anthropic/claude-3-5-sonnet-20241022
GM_FALLBACK_MODEL=openai/gpt-4o-mini
AGENT_MODEL=openai/gpt-4o-mini
AGENT_FALLBACK_MODEL=anthropic/claude-3-5-haiku-20241022
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_FALLBACKS=2
LLM_DEFAULT_TEMPERATURE=0.8

# Audio Narration
# Get these from your ElevenLabs dashboard / voices API.
# ELEVENLABS_API_KEY=...
# Example general-purpose model: eleven_multilingual_v2
ELEVENLABS_MODEL_ID=your_model_id
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128
ELEVENLABS_TIMEOUT_SECONDS=8
ELEVENLABS_STABILITY=0.6
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=0.95

# App
ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=["http://localhost:5173"]
