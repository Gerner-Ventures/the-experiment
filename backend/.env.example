# Database
DATABASE_URL=postgresql+asyncpg://experiment:experiment@localhost:5432/experiment

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM Providers (configure the ones you use)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
GM_MODEL=anthropic/claude-3-5-sonnet-20241022
GM_FALLBACK_MODEL=openai/gpt-4o-mini
AGENT_MODEL=openai/gpt-4o-mini
AGENT_FALLBACK_MODEL=anthropic/claude-3-5-haiku-20241022
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_MAX_FALLBACKS=2
LLM_DEFAULT_TEMPERATURE=0.8

# App
ENV=development
LOG_LEVEL=debug
CORS_ORIGINS=["http://localhost:5173"]
